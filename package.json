{
  "name": "mouthpiece",
  "private": true,
  "version": "0.4.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:mock": "VITE_MOCK_BACKEND=1 vite --port 1430",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:rust": "cd src-tauri && cargo test --lib",
    "test:audio": "cd src-tauri && cargo test --lib e2e_audio -- --ignored --nocapture --test-threads=1",
    "test": "bun run typecheck && bun run test:rust && bun run test:e2e"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "daisyui": "^5.7.17",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.3.7"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
